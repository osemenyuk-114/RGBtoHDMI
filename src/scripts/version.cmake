if(NOT DEFINED PROJECT_SOURCE_DIR OR NOT DEFINED OUTPUT_FILE)
    message(FATAL_ERROR "PROJECT_SOURCE_DIR and OUTPUT_FILE must be set")
endif()

execute_process(
    COMMAND git rev-parse --short HEAD
    WORKING_DIRECTORY "${PROJECT_SOURCE_DIR}"
    RESULT_VARIABLE GIT_HASH_RESULT
    OUTPUT_VARIABLE GIT_HASH
    ERROR_VARIABLE GIT_HASH_ERROR
    OUTPUT_STRIP_TRAILING_WHITESPACE
)
if(NOT GIT_HASH_RESULT EQUAL 0)
    message(FATAL_ERROR "git rev-parse failed: ${GIT_HASH_ERROR}")
endif()

execute_process(
    COMMAND git status --untracked-files=no --porcelain
    WORKING_DIRECTORY "${PROJECT_SOURCE_DIR}"
    RESULT_VARIABLE GIT_STATUS_RESULT
    OUTPUT_VARIABLE GIT_STATUS
    ERROR_VARIABLE GIT_STATUS_ERROR
    OUTPUT_STRIP_TRAILING_WHITESPACE
)
if(NOT GIT_STATUS_RESULT EQUAL 0)
    message(FATAL_ERROR "git status failed: ${GIT_STATUS_ERROR}")
endif()

string(TIMESTAMP BUILD_DATE "%Y%m%d")
set(VERSION "${BUILD_DATE} ${GIT_HASH}")
if(GIT_STATUS)
    string(APPEND VERSION "?")
endif()
set(HEADER_CONTENT "#define GITVERSION \"${VERSION}\"\n")

if(EXISTS "${OUTPUT_FILE}")
    file(READ "${OUTPUT_FILE}" CURRENT_HEADER)
else()
    set(CURRENT_HEADER "")
endif()

if(NOT "${CURRENT_HEADER}" STREQUAL "${HEADER_CONTENT}")
    file(WRITE "${OUTPUT_FILE}" "${HEADER_CONTENT}")
endif()
